# Copy to .env.local for `npm run dev`. In production these live in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# ── Server-side only (Vercel functions in /api) ─────────────────────────
# Long random string. Enter the same value on each screen in
# Parent → Connections. Generate one with:  openssl rand -hex 24
# (Only for screens that aren't signed in to a family account.)
HUB_ACCESS_KEY=

# ── Family accounts (hub Supabase project, docs/ACCOUNTS.md) ────────────
# Server: checks sign-ins and reads each family's saved connections.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Encrypts each family's saved links and tokens. openssl rand -hex 32
# Never change it once families have saved connections (they'd need re-entering).
HUB_SECRETS_KEY=
# The Carlsons' household id: this family also uses the Vercel values below.
HUB_HOME_HOUSEHOLD_ID=
# Let every family use "Snap a notice" on the hub's Anthropic key (default: home family only)
# SNAP_FOR_ALL_FAMILIES=true

# ── The home family's connections (other families save theirs in the app) ──
# Google Calendar → Settings for the family calendar → "Secret address in iCal format"
FAMILY_ICAL_URL=
# Optional: Airbnb bookings/cleans calendar and a kids' calendar (same kind of link)
BOOKINGS_ICAL_URL=
KIDS_ICAL_URL=
# Notion internal integration connected to the "Home Hub" page
NOTION_TOKEN=
# For "Snap a notice" (reads school newsletters into events)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# DeepSeek: summarises the recorded dinnertime chat and reads recipes off web pages
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_FOR_ALL_FAMILIES=true

# Google service account for the slideshow and (later) two-way calendar.
# Base64 of the JSON key file:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("home-hub-xxxx.json"))
GOOGLE_SERVICE_ACCOUNT_JSON=
# The "Home Hub Slideshow" Google Drive folder id (share it with the
# service-account email). Copy the id from the folder's URL.
SLIDESHOW_DRIVE_FOLDER_ID=

# ── Browser (public publishable keys, safe to ship) ─────────────────────
# Home Hub's own Supabase project (family sign-in and sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# SIGNAL: copy VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY from the signalnz repo
VITE_SIGNAL_SUPABASE_URL=
VITE_SIGNAL_SUPABASE_KEY=
# Where SIGNAL's recipe photos are served from
VITE_SIGNAL_SITE_URL=https://signal.mindcast.co.nz
# PointPals: copy VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY from the point-pals-app project
VITE_POINTPALS_SUPABASE_URL=
VITE_POINTPALS_SUPABASE_KEY=
